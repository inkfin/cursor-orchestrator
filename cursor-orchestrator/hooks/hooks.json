{
  "version": 1,
  "hooks": {
    "subagentStart": [
      {
        "command": "command -v python3 >/dev/null 2>&1 && [ -f \"${CURSOR_PLUGIN_ROOT:-}/hooks/task-contract-guard.py\" ] && exec python3 \"${CURSOR_PLUGIN_ROOT:-}/hooks/task-contract-guard.py\" || printf '{\"permission\":\"allow\"}\\n'",
        "matcher": "fixer|designer",
        "failClosed": false
      }
    ],
    "preToolUse": [
      {
        "command": "command -v python3 >/dev/null 2>&1 && [ -f \"${CURSOR_PLUGIN_ROOT:-}/hooks/task-contract-guard.py\" ] && exec python3 \"${CURSOR_PLUGIN_ROOT:-}/hooks/task-contract-guard.py\" || printf '{\"permission\":\"allow\"}\\n'",
        "matcher": "Task",
        "failClosed": false
      }
    ]
  }
}
